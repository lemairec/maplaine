{% extends 'base_agri.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css" />
<style>
.parcellaire-layout {
    display: flex;
    gap: 0;
    height: calc(100vh - 130px);
    min-height: 500px;
}

/* Panneau gauche */
.parcellaire-sidebar {
    width: 360px;
    min-width: 280px;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    border-right: 1px solid #dee2e6;
    background: #f8f9fa;
    overflow: hidden;
}
.parcellaire-sidebar-header {
    padding: 12px 16px;
    border-bottom: 1px solid #dee2e6;
    background: #fff;
    flex-shrink: 0;
}
.parcellaire-sidebar-body {
    overflow-y: auto;
    flex: 1;
}

/* Carte droite */
.parcellaire-map {
    flex: 1;
    position: relative;
}
#carte-parcelles {
    width: 100%;
    height: 100%;
}

/* Items parcelles */
.parcelle-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-bottom: 1px solid #e9ecef;
    cursor: pointer;
    background: #fff;
    transition: background 0.12s;
    text-decoration: none;
    color: inherit;
    user-select: none;
}
.parcelle-item:hover { background: #e9f2ff; }
.parcelle-item.active { background: #dbeafe; }
.parcelle-item.merge-selected { background: #fef9c3; border-left: 3px solid #f59e0b; }
.parcelle-color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,0.15);
}
.parcelle-item-name { font-weight: 600; font-size: 0.9rem; line-height: 1.2; }
.parcelle-item-sub  { font-size: 0.78rem; color: #6c757d; }
.parcelle-item-surface { margin-left: auto; font-size: 0.82rem; color: #495057; white-space: nowrap; }

/* Barre fusion (bas de sidebar) */
#merge-bar {
    display: none;
    padding: 10px 14px;
    background: #fef3c7;
    border-top: 2px solid #f59e0b;
    flex-shrink: 0;
    font-size: 0.85rem;
}
#merge-bar.visible { display: block; }

/* Contrôle couches */
.map-layer-control {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1000;
}

@media (max-width: 768px) {
    .parcellaire-layout { flex-direction: column; height: auto; }
    .parcellaire-sidebar { width: 100%; max-width: none; border-right: none; border-bottom: 1px solid #dee2e6; max-height: 320px; }
    .parcellaire-map { height: 400px; }
}

/* Barre d'édition contour */
#edit-contour-bar {
    display: none;
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2000;
    background: #1e293b;
    color: #fff;
    border-radius: 999px;
    padding: 10px 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.35);
    gap: 10px;
    align-items: center;
    white-space: nowrap;
}
#edit-contour-bar.visible { display: flex; }

/* Barre de coupe */
#split-bar {
    display: none;
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2000;
    background: #1e293b;
    color: #fff;
    border-radius: 999px;
    padding: 10px 20px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.35);
    gap: 10px;
    align-items: center;
    white-space: nowrap;
}
#split-bar.visible { display: flex; }
</style>
{% endblock %}

{% block body %}

{% set carte_data = [] %}
{% for p in parcelles %}
    {% if p.active %}
    {% set carte_data = carte_data|merge([{
        'id':      p.id,
        'name':    p.completeName,
        'surface': p.surface,
        'culture': p.culture ? p.culture.name : '',
        'color':   (p.culture and p.culture.color) ? p.culture.color : '#3388ff',
        'geoJson': p.geoJson,
        'url':     url('parcelle', {'parcelle_id': p.id}),
    }]) %}
    {% endif %}
{% endfor %}

<div class="parcellaire-layout">

    {# ---- Panneau gauche ---- #}
    <div class="parcellaire-sidebar">

        <div class="parcellaire-sidebar-header">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <strong>{{ parcelles | filter(p => p.active) | length }} parcelles</strong>
                <div class="d-flex gap-1">
                    <a href="{{ path('parcelles') }}" class="btn btn-sm btn-outline-secondary" title="Vue tableau">
                        ☰ Tableau
                    </a>
                    {% if parcelles | length == 0 %}
                    <button id="btn-copy-previous" class="btn btn-sm btn-outline-primary" title="Copier les parcelles de la campagne précédente">
                        ⧉ Copier campagne précédente
                    </button>
                    {% endif %}
                    <button id="btn-mode-fusion" class="btn btn-sm btn-outline-warning" title="Mode fusion">
                        ⊕ Fusionner
                    </button>
                    <button id="btn-mode-draw" class="btn btn-sm btn-success" title="Dessiner une nouvelle parcelle">
                        + Ajouter
                    </button>
                </div>
            </div>
            {% set total_ha = 0 %}
            {% for p in parcelles %}{% if p.active %}{% set total_ha = total_ha + p.surface %}{% endif %}{% endfor %}
            <div class="text-muted" style="font-size:0.82rem">Total : {{ total_ha | showHa }}</div>
        </div>

        <div class="parcellaire-sidebar-body">
            {% for p in parcelles %}{% if p.active %}
            <a href="{{ url('parcelle', {'parcelle_id': p.id}) }}"
               class="parcelle-item"
               data-parcelle-id="{{ p.id }}"
               data-surface="{{ p.surface }}"
               title="{{ p.completeName }}">
                <span class="parcelle-color-dot"
                      style="background: {{ (p.culture and p.culture.color) ? p.culture.color : '#ccc' }}"></span>
                <span>
                    <div class="parcelle-item-name">{{ p.completeName }}</div>
                    <div class="parcelle-item-sub">
                        {{ p.culture ? p.culture : '—' }}
                        {% if p.getIlotName() %} · {{ p.getIlotName() }}{% endif %}
                    </div>
                </span>
                <span class="parcelle-item-surface">{{ p.surface | showHa }}</span>
            </a>
            {% endif %}{% endfor %}
        </div>

        {# Barre fusion #}
        <div id="merge-bar">
            <div id="merge-info" class="mb-2 fw-semibold"></div>
            <div class="d-flex gap-2">
                <button id="btn-do-merge" class="btn btn-sm btn-warning" disabled>Fusionner</button>
                <button id="btn-cancel-merge" class="btn btn-sm btn-outline-secondary">Annuler</button>
            </div>
        </div>

    </div>

    {# ---- Carte droite ---- #}
    <div class="parcellaire-map">
        <div id="carte-parcelles"></div>
        <div class="map-layer-control btn-group btn-group-sm shadow-sm">
            <button class="btn btn-light active" id="btn-layer-sat">Satellite</button>
            <button class="btn btn-light" id="btn-layer-osm">Plan</button>
        </div>
    </div>

</div>

{# Modal : nom de la nouvelle parcelle #}
<div class="modal fade" id="modal-merge" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Fusionner les parcelles</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body">
        <div id="merge-modal-summary" class="text-muted small mb-3"></div>
        <label class="form-label font-weight-bold">Nom de la nouvelle parcelle</label>
        <input type="text" class="form-control" id="merge-name" placeholder="Ex : Parcelle A+B" />
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-dismiss="modal">Annuler</button>
        <button class="btn btn-warning" id="btn-confirm-merge">Fusionner</button>
      </div>
    </div>
  </div>
</div>

{# Barre flottante édition contour #}
<div id="edit-contour-bar">
    <span>✏ Contour</span>
    <span id="contour-surface" style="font-weight:600; color:#86efac; min-width:80px; text-align:right;">— ha</span>
    <button class="btn btn-sm btn-success" id="btn-contour-save">✔ Valider</button>
    <button class="btn btn-sm btn-outline-light" id="btn-contour-cancel">✕ Annuler</button>
</div>

{# Barre flottante coupe de parcelle #}
<div id="split-bar">
    <span>✂ Tracez une ligne traversant la parcelle pour la couper en 2</span>
    <button class="btn btn-sm btn-outline-light" id="btn-split-cancel">✕ Annuler</button>
</div>

{# Modal : nommer les 2 parcelles issues de la coupe #}
<div class="modal fade" id="modal-split" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Couper la parcelle</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label font-weight-bold">Nom de la 1<sup>re</sup> partie</label>
          <input type="text" class="form-control" id="split-name-a" placeholder="Ex : Parcelle A" />
          <div class="text-success small mt-1" id="split-surface-a">— ha</div>
        </div>
        <div class="mb-2">
          <label class="form-label font-weight-bold">Nom de la 2<sup>e</sup> partie</label>
          <input type="text" class="form-control" id="split-name-b" placeholder="Ex : Parcelle B" />
          <div class="text-success small mt-1" id="split-surface-b">— ha</div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-dismiss="modal">Annuler</button>
        <button class="btn btn-danger" id="btn-confirm-split">✂ Couper</button>
      </div>
    </div>
  </div>
</div>

{# Modal : nouvelle parcelle #}
<div class="modal fade" id="modal-new-parcelle" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Nouvelle parcelle</h5>
        <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body">
        <div class="mb-2">
          <label class="font-weight-bold">Surface calculée</label>
          <div id="new-parcelle-surface" class="text-success font-weight-bold">— ha</div>
        </div>
        <div class="mb-2">
          <label class="font-weight-bold">Nom <span class="text-danger">*</span></label>
          <input type="text" class="form-control" id="new-parcelle-name" placeholder="Ex : P1 - Grande pièce" />
        </div>
        <div class="mb-2">
          <label>Culture</label>
          <select class="form-control" id="new-parcelle-culture">
            <option value="">— Aucune —</option>
            {% for c in cultures_list %}
            <option value="{{ c.id }}">{{ c.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="mb-2">
          <label>Îlot</label>
          <select class="form-control" id="new-parcelle-ilot">
            <option value="">— Aucun —</option>
            {% for i in ilots_list %}
            <option value="{{ i.id }}">{{ i.name }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="mb-2">
          <label>Commune</label>
          <input type="text" class="form-control" id="new-parcelle-commune" />
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-dismiss="modal">Annuler</button>
        <button class="btn btn-primary" id="btn-confirm-new-parcelle">Créer</button>
      </div>
    </div>
  </div>
</div>

<script>const CARTE_PARCELLES = {{ carte_data | json_encode | raw }};</script>
<script>const MERGE_URL = '{{ url('parcelles_merge') }}';</script>
<script>const GEOJSON_BASE_URL = '{{ url('parcelle_geojson', {'parcelle_id': '__ID__'}) }}';</script>
<script>const CREATE_URL = '{{ url('parcelle_create_map') }}';</script>
<script>const COPY_PREVIOUS_URL = '{{ url('parcelles_copy_previous') }}';</script>
<script>const SPLIT_URL = '{{ url('parcelles_split') }}';</script>

{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.js"></script>
<script src="https://unpkg.com/@turf/turf@7/turf.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const parcelles = CARTE_PARCELLES;
    const layerMap  = {};   // id → L.GeoJSON layer
    const dataMap   = {};   // id → parcelle data object

    // ---- Carte ----
    const map = L.map('carte-parcelles').setView([46.6, 2.5], 6);
    const satLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { attribution: '© Esri', maxZoom: 19 });
    const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',  { attribution: '© OpenStreetMap', maxZoom: 20 });
    satLayer.addTo(map);

    document.getElementById('btn-layer-sat').addEventListener('click', function () {
        osmLayer.remove(); satLayer.addTo(map);
        this.classList.add('active'); document.getElementById('btn-layer-osm').classList.remove('active');
    });
    document.getElementById('btn-layer-osm').addEventListener('click', function () {
        satLayer.remove(); osmLayer.addTo(map);
        this.classList.add('active'); document.getElementById('btn-layer-sat').classList.remove('active');
    });

    const defaultStyle = { color: '#333', weight: 2, fillOpacity: 0.5 };
    const mergeStyle   = { color: '#f59e0b', weight: 3, fillOpacity: 0.6 };

    const allLayers = [];
    parcelles.forEach(function (p) {
        dataMap[p.id] = p;
        if (!p.geoJson) return;
        let geojson;
        try { geojson = JSON.parse(p.geoJson); } catch (e) { return; }

        const layer = L.geoJSON(geojson, {
            style: Object.assign({}, defaultStyle, { fillColor: p.color || '#3388ff' }),
        });

        const surface = p.surface ? p.surface.toFixed(2) + ' ha' : '—';
        layer.bindPopup(
            '<b>' + (p.name || '—') + '</b><br/>' +
            (p.culture ? p.culture + '<br/>' : '') +
            surface +
            '<br/><a href="' + p.url + '">Fiche</a>' +
            ' &nbsp; <a href="#" class="popup-edit-contour" data-id="' + p.id + '">✏ Contour</a>' +
            ' &nbsp; <a href="#" class="popup-split" data-id="' + p.id + '">✂ Couper</a>'
        );
        layer.bindTooltip('<b>' + (p.name || '—') + '</b><br/>' + surface, { sticky: true });

        // Clic sur la carte → sélection bidirectionnelle
        layer.on('click', function () {
            if (mergeMode) {
                toggleMergeById(p.id);
            } else {
                selectParcelle(p.id, false); // false = ne pas re-zoomer (on est déjà sur la carte)
            }
        });

        layer.addTo(map);
        allLayers.push(layer);
        layerMap[p.id] = layer;
    });

    if (allLayers.length > 0) {
        map.fitBounds(L.featureGroup(allLayers).getBounds(), { padding: [20, 20] });
    }

    // ---- Sélection unifiée (liste ↔ carte) ----
    function selectParcelle(id, zoomToLayer) {
        // Liste : highlight + scroll
        document.querySelectorAll('.parcelle-item').forEach(el => el.classList.remove('active'));
        const listEl = document.querySelector('.parcelle-item[data-parcelle-id="' + id + '"]');
        if (listEl) {
            listEl.classList.add('active');
            listEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }

        // Carte : zoom + popup
        const layer = layerMap[id];
        if (layer) {
            if (zoomToLayer) {
                map.fitBounds(layer.getBounds(), { padding: [40, 40], maxZoom: 18 });
            }
            layer.eachLayer(l => l.openPopup(layer.getBounds().getCenter()));
        }
    }

    // Clic sur la liste → sélection + zoom
    document.querySelectorAll('.parcelle-item').forEach(function (el) {
        el.addEventListener('click', function (e) {
            if (mergeMode) return;
            const id = this.dataset.parcelleId;
            if (!layerMap[id]) return; // pas de contour → navigation normale
            e.preventDefault();
            selectParcelle(id, true);
        });
    });

    // ---- Mode fusion ----
    let mergeMode = false;
    const mergeSelection = new Set();

    function enterMergeMode() {
        mergeMode = true;
        document.getElementById('btn-mode-fusion').classList.replace('btn-outline-warning', 'btn-warning');
        document.getElementById('btn-mode-fusion').textContent = '✕ Quitter fusion';
        document.getElementById('merge-bar').classList.add('visible');
        map.closePopup();
        updateMergeUI();
    }

    function exitMergeMode() {
        mergeMode = false;
        mergeSelection.clear();
        document.getElementById('btn-mode-fusion').classList.replace('btn-warning', 'btn-outline-warning');
        document.getElementById('btn-mode-fusion').textContent = '⊕ Fusionner';
        document.getElementById('merge-bar').classList.remove('visible');
        document.querySelectorAll('.parcelle-item').forEach(el => {
            el.classList.remove('merge-selected');
        });
        Object.values(layerMap).forEach(function (layer) {
            const p = parcelles.find(x => layerMap[x.id] === layer);
            if (p) layer.setStyle(Object.assign({}, defaultStyle, { fillColor: p.color || '#3388ff' }));
        });
    }

    function updateMergeUI() {
        const n = mergeSelection.size;
        const surface = [...mergeSelection].reduce((s, id) => s + (dataMap[id] ? (dataMap[id].surface || 0) : 0), 0);
        document.getElementById('merge-info').textContent =
            n + ' parcelle' + (n > 1 ? 's' : '') + ' sélectionnée' + (n > 1 ? 's' : '') +
            (surface > 0 ? ' · ' + surface.toFixed(2) + ' ha' : '');
        document.getElementById('btn-do-merge').disabled = n < 2;
    }

    function toggleMergeById(id) {
        const listEl = document.querySelector('.parcelle-item[data-parcelle-id="' + id + '"]');
        const p = dataMap[id];
        if (mergeSelection.has(id)) {
            mergeSelection.delete(id);
            if (listEl) { listEl.classList.remove('merge-selected'); listEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
            if (layerMap[id] && p) layerMap[id].setStyle(Object.assign({}, defaultStyle, { fillColor: p.color || '#3388ff' }));
        } else {
            mergeSelection.add(id);
            if (listEl) { listEl.classList.add('merge-selected'); listEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
            if (layerMap[id]) layerMap[id].setStyle(mergeStyle);
        }
        updateMergeUI();
    }

    // Clic en mode fusion depuis la liste
    document.querySelectorAll('.parcelle-item').forEach(function (el) {
        el.addEventListener('click', function (e) {
            if (!mergeMode) return;
            e.preventDefault();
            toggleMergeById(this.dataset.parcelleId);
        });
    });

    document.getElementById('btn-mode-fusion').addEventListener('click', function () {
        mergeMode ? exitMergeMode() : enterMergeMode();
    });
    document.getElementById('btn-cancel-merge').addEventListener('click', exitMergeMode);

    // ---- Copie des parcelles de la campagne précédente ----
    const btnCopyPrevious = document.getElementById('btn-copy-previous');
    if (btnCopyPrevious) {
        btnCopyPrevious.addEventListener('click', function () {
            if (!confirm('Copier les parcelles de la campagne précédente dans la campagne actuelle ?')) return;
            btnCopyPrevious.disabled = true;
            fetch(COPY_PREVIOUS_URL, { method: 'POST' })
                .then(r => r.json())
                .then(function (data) {
                    if (data.ok) window.location.href = data.redirect || window.location.href;
                    else { alert('Erreur : ' + (data.error || 'inconnue')); btnCopyPrevious.disabled = false; }
                })
                .catch(() => { alert('Erreur réseau'); btnCopyPrevious.disabled = false; });
        });
    }

    // Ouvrir modal de confirmation
    document.getElementById('btn-do-merge').addEventListener('click', function () {
        const names = [...mergeSelection].map(id => dataMap[id] ? dataMap[id].name : id).join(' + ');
        const surface = [...mergeSelection].reduce((s, id) => s + (dataMap[id] ? (dataMap[id].surface || 0) : 0), 0);
        document.getElementById('merge-modal-summary').textContent =
            'Fusion de : ' + names + ' (' + surface.toFixed(2) + ' ha)';
        document.getElementById('merge-name').value = names;
        $('#modal-merge').modal('show');
    });

    // Confirmer la fusion
    document.getElementById('btn-confirm-merge').addEventListener('click', function () {
        const name = document.getElementById('merge-name').value.trim();
        if (!name) { document.getElementById('merge-name').focus(); return; }

        // Union des polygones avec Turf.js
        const ids = [...mergeSelection];
        let unionGeoJson = null;
        try {
            const features = ids
                .filter(id => dataMap[id] && dataMap[id].geoJson)
                .map(id => {
                    const parsed = JSON.parse(dataMap[id].geoJson);
                    // Normaliser en Feature si besoin
                    if (parsed.type === 'Feature') return parsed;
                    return turf.feature(parsed);
                });

            if (features.length >= 2) {
                let union = features[0];
                for (let i = 1; i < features.length; i++) {
                    union = turf.union(turf.featureCollection([union, features[i]]));
                }
                unionGeoJson = JSON.stringify(union.geometry);
            } else if (features.length === 1) {
                unionGeoJson = JSON.stringify(features[0].geometry);
            }
        } catch (e) {
            console.warn('Union Turf échouée, geoJson ignoré', e);
        }

        fetch(MERGE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ parcelle_ids: ids, name: name, geoJson: unionGeoJson }),
        })
        .then(r => r.json())
        .then(function (data) {
            if (data.ok) window.location.href = data.redirect || window.location.href;
            else alert('Erreur : ' + (data.error || 'inconnue'));
        })
        .catch(() => alert('Erreur réseau'));
    });

    // ---- Édition du contour ----
    const drawLayer = L.featureGroup().addTo(map);
    const drawControl = new L.Control.Draw({
        draw: {
            polygon:     { allowIntersection: false, shapeOptions: { color: '#22c55e', weight: 2 } },
            polyline:    false,
            rectangle:   false,
            circle:      false,
            marker:      false,
            circlemarker: false,
        },
        edit: { featureGroup: drawLayer, remove: false },
    });

    let editingId = null;
    let editingOriginalLayer = null;

    function startEditContour(id) {
        if (mergeMode) return;
        map.closePopup();
        editingId = id;

        // Cacher l'ancienne couche sur la carte principale
        editingOriginalLayer = layerMap[id];
        if (editingOriginalLayer) map.removeLayer(editingOriginalLayer);

        // Charger le polygone dans drawLayer
        drawLayer.clearLayers();
        showSurface(null);
        const p = dataMap[id];
        if (p && p.geoJson) {
            try {
                const geojson = JSON.parse(p.geoJson);
                const editLayer = L.geoJSON(geojson, { style: { color: '#22c55e', weight: 3, fillOpacity: 0.3 } });
                editLayer.eachLayer(l => {
                    drawLayer.addLayer(l);
                    if (l.editing) l.editing.enable();
                    const latlngs = l.getLatLngs ? l.getLatLngs()[0] : null;
                    if (latlngs) showSurface(computeAreaHa(latlngs));
                });
                map.fitBounds(drawLayer.getBounds(), { padding: [40, 40] });
            } catch(e) {}
        }

        map.addControl(drawControl);
        document.getElementById('edit-contour-bar').classList.add('visible');
    }

    function stopEditContour(save) {
        if (!editingId) return;

        if (save) {
            let newGeoJson = null;
            let newSurface = null;
            const layers = drawLayer.getLayers();
            if (layers.length > 0) {
                const drawn = layers[layers.length - 1];
                newGeoJson = JSON.stringify(drawn.toGeoJSON().geometry);
                const latlngs = drawn.getLatLngs ? drawn.getLatLngs()[0] : null;
                if (latlngs) newSurface = computeAreaHa(latlngs);
            }

            const url = GEOJSON_BASE_URL.replace('__ID__', editingId);
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ geoJson: newGeoJson, surface: newSurface }),
            })
            .then(r => r.json())
            .then(function(data) {
                if (data.ok) window.location.reload();
                else alert('Erreur lors de la sauvegarde');
            })
            .catch(() => alert('Erreur réseau'));
        } else {
            // Annuler : remettre l'ancienne couche
            if (editingOriginalLayer) map.addLayer(editingOriginalLayer);
        }

        map.removeControl(drawControl);
        drawLayer.clearLayers();
        showSurface(null);
        document.getElementById('edit-contour-bar').classList.remove('visible');
        editingId = null;
        editingOriginalLayer = null;
    }

    // ---- Calcul surface en temps réel ----
    function showSurface(ha) {
        document.getElementById('contour-surface').textContent = ha != null ? ha.toFixed(4) + ' ha' : '— ha';
    }

    function computeAreaHa(latlngs) {
        // latlngs : tableau de L.LatLng (anneau du polygone)
        if (!latlngs || latlngs.length < 3) return null;
        const coords = latlngs.map(ll => [ll.lng, ll.lat]);
        coords.push(coords[0]); // fermer l'anneau
        try {
            const poly = turf.polygon([coords]);
            return turf.area(poly) / 10000; // m² → ha
        } catch(e) { return null; }
    }

    // Pendant le tracé (ajout de chaque sommet)
    map.on('draw:drawvertex', function(e) {
        if (splitMode) return; // la ligne de coupe n'a pas de "surface" à afficher ici
        // Récupérer le layer en cours depuis le gestionnaire de dessin
        const handler = e.layers;
        if (!handler) return;
        handler.eachLayer(function(l) {
            const latlngs = l.getLatLngs ? l.getLatLngs()[0] : null;
            if (latlngs) showSurface(computeAreaHa(latlngs));
        });
    });

    // Après création d'un polygone (mode édition contour seulement)
    map.on('draw:created', function(e) {
        if (drawMode || splitMode) return; // gérés par leurs propres listeners
        drawLayer.clearLayers();
        drawLayer.addLayer(e.layer);
        const latlngs = e.layer.getLatLngs()[0];
        showSurface(computeAreaHa(latlngs));
    });

    // Après tracé de la ligne de coupe (mode split)
    map.on('draw:created', function (e) {
        if (!splitMode) return;
        const lineCoords = e.layer.getLatLngs().map(ll => [ll.lng, ll.lat]);
        if (lineCoords.length < 2) return;

        const p = dataMap[splitTargetId];
        if (!p || !p.geoJson) { alert('Contour introuvable pour cette parcelle'); return; }

        let polygonGeoJson;
        try { polygonGeoJson = JSON.parse(p.geoJson); } catch (e2) { alert('Contour invalide'); return; }

        const result = splitPolygonByLine(polygonGeoJson, lineCoords);
        if (!result) {
            alert("Impossible de couper la parcelle avec cette ligne : tracez une ligne qui traverse bien la parcelle de part en part.");
            return;
        }

        splitResult = result;
        splitPreviewLayer.clearLayers();
        L.geoJSON(result.partA, { style: { color: '#2563eb', weight: 2, fillOpacity: 0.4 } }).addTo(splitPreviewLayer);
        L.geoJSON(result.partB, { style: { color: '#dc2626', weight: 2, fillOpacity: 0.4 } }).addTo(splitPreviewLayer);
        map.removeControl(splitDrawControl);

        const surfaceA = turf.area(result.partA) / 10000;
        const surfaceB = turf.area(result.partB) / 10000;

        document.getElementById('split-name-a').value = '';
        document.getElementById('split-name-b').value = '';
        document.getElementById('split-surface-a').textContent = surfaceA.toFixed(4) + ' ha';
        document.getElementById('split-surface-b').textContent = surfaceB.toFixed(4) + ' ha';
        $('#modal-split').modal('show');
    });

    // Pendant l'édition des sommets
    map.on('draw:editvertex', function() {
        drawLayer.eachLayer(function(l) {
            const latlngs = l.getLatLngs ? l.getLatLngs()[0] : null;
            if (latlngs) showSurface(computeAreaHa(latlngs));
        });
    });

    // Après validation de l'édition
    map.on('draw:edited', function() {
        drawLayer.eachLayer(function(l) {
            const latlngs = l.getLatLngs ? l.getLatLngs()[0] : null;
            if (latlngs) showSurface(computeAreaHa(latlngs));
        });
    });

    document.getElementById('btn-contour-save').addEventListener('click', () => stopEditContour(true));
    document.getElementById('btn-contour-cancel').addEventListener('click', () => stopEditContour(false));

    // ---- Coupe d'une parcelle en 2 ----
    let splitMode = false;
    let splitTargetId = null;
    let splitOriginalLayer = null;
    let splitResult = null; // { partA, partB } (Features Turf)
    const splitPreviewLayer = L.featureGroup().addTo(map);

    const splitDrawControl = new L.Control.Draw({
        draw: {
            polyline:     { shapeOptions: { color: '#dc2626', weight: 3 } },
            polygon:      false, rectangle: false, circle: false, marker: false, circlemarker: false,
        },
        edit: false,
    });

    function enterSplitMode(id) {
        if (mergeMode) exitMergeMode();
        if (drawMode) exitDrawMode();
        map.closePopup();
        splitMode = true;
        splitTargetId = id;

        splitOriginalLayer = layerMap[id];
        if (splitOriginalLayer) map.removeLayer(splitOriginalLayer);

        document.getElementById('split-bar').classList.add('visible');
        map.addControl(splitDrawControl);
    }

    function exitSplitMode() {
        if (splitOriginalLayer) map.addLayer(splitOriginalLayer);
        splitMode = false;
        splitTargetId = null;
        splitOriginalLayer = null;
        splitResult = null;
        splitPreviewLayer.clearLayers();
        document.getElementById('split-bar').classList.remove('visible');
        try { map.removeControl(splitDrawControl); } catch (e) {}
    }

    // Coupe un polygone en 2 avec une ligne : construit un très grand demi-plan
    // le long de la ligne (étendue au-delà du polygone) puis intersecte/soustrait.
    function splitPolygonByLine(polygonGeoJson, lineCoords) {
        const p1 = lineCoords[0];
        const p2 = lineCoords[lineCoords.length - 1];

        const polyFeature = polygonGeoJson.type === 'Feature' ? polygonGeoJson : turf.feature(polygonGeoJson);
        const bbox = turf.bbox(polyFeature);
        const span = Math.max(bbox[2] - bbox[0], bbox[3] - bbox[1]) || 0.001;
        const ext = span * 20;

        let dx = p2[0] - p1[0];
        let dy = p2[1] - p1[1];
        const len = Math.sqrt(dx * dx + dy * dy) || 1;
        dx /= len; dy /= len;

        const A = [p1[0] - dx * ext, p1[1] - dy * ext];
        const B = [p2[0] + dx * ext, p2[1] + dy * ext];
        const nx = -dy, ny = dx;
        const C = [B[0] + nx * ext, B[1] + ny * ext];
        const D = [A[0] + nx * ext, A[1] + ny * ext];

        const halfPlane = turf.polygon([[A, B, C, D, A]]);

        try {
            const partA = turf.intersect(turf.featureCollection([polyFeature, halfPlane]));
            if (!partA) return null;
            const partB = turf.difference(turf.featureCollection([polyFeature, partA]));
            if (!partB) return null;
            return { partA: partA, partB: partB };
        } catch (e) {
            console.warn('Découpe Turf échouée', e);
            return null;
        }
    }

    document.getElementById('btn-split-cancel').addEventListener('click', exitSplitMode);

    $('#modal-split').on('hidden.bs.modal', function () {
        if (splitMode && splitResult) exitSplitMode();
    });

    document.getElementById('btn-confirm-split').addEventListener('click', function () {
        const nameA = document.getElementById('split-name-a').value.trim();
        const nameB = document.getElementById('split-name-b').value.trim();
        if (!nameA) { document.getElementById('split-name-a').focus(); return; }
        if (!nameB) { document.getElementById('split-name-b').focus(); return; }
        if (!splitResult) return;

        const surfaceA = turf.area(splitResult.partA) / 10000;
        const surfaceB = turf.area(splitResult.partB) / 10000;

        fetch(SPLIT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                parcelle_id: splitTargetId,
                name_a:      nameA,
                name_b:      nameB,
                geoJson_a:   JSON.stringify(splitResult.partA.geometry),
                geoJson_b:   JSON.stringify(splitResult.partB.geometry),
                surface_a:   surfaceA,
                surface_b:   surfaceB,
            }),
        })
        .then(r => r.json())
        .then(function (data) {
            if (data.ok) {
                splitResult = null; // éviter le retour en mode coupe via hidden.bs.modal
                $('#modal-split').modal('hide');
                window.location.href = data.redirect || window.location.href;
            } else {
                alert('Erreur : ' + (data.error || 'inconnue'));
            }
        })
        .catch(() => alert('Erreur réseau'));
    });

    // Clic sur le lien "✂ Couper" dans le popup
    map.on('popupopen', function (e) {
        e.popup.getElement().querySelectorAll('.popup-split').forEach(function (a) {
            a.addEventListener('click', function (ev) {
                ev.preventDefault();
                enterSplitMode(this.dataset.id);
            });
        });
    });

    // ---- Mode dessin nouvelle parcelle ----
    let drawMode = false;
    let drawnNewGeoJson = null;
    let drawnNewSurface = null;

    const newDrawControl = new L.Control.Draw({
        draw: {
            polygon:     { allowIntersection: false, shapeOptions: { color: '#2563eb', weight: 2 } },
            polyline:    false, rectangle: false, circle: false, marker: false, circlemarker: false,
        },
        edit: false,
    });

    function enterDrawMode() {
        if (mergeMode) exitMergeMode();
        drawMode = true;
        document.getElementById('btn-mode-draw').classList.replace('btn-success', 'btn-danger');
        document.getElementById('btn-mode-draw').textContent = '✕ Annuler';
        map.closePopup();
        map.addControl(newDrawControl);
    }

    function exitDrawMode() {
        drawMode = false;
        drawnNewGeoJson = null;
        drawnNewSurface = null;
        document.getElementById('btn-mode-draw').classList.replace('btn-danger', 'btn-success');
        document.getElementById('btn-mode-draw').textContent = '+ Ajouter';
        map.removeControl(newDrawControl);
        // Supprimer le polygone temporaire s'il existe
        drawLayer.eachLayer(l => { if (l._isNewParcelle) drawLayer.removeLayer(l); });
    }

    document.getElementById('btn-mode-draw').addEventListener('click', function() {
        drawMode ? exitDrawMode() : enterDrawMode();
    });

    // Après tracé du polygone en mode "nouvelle parcelle"
    map.on('draw:created', function(e) {
        if (!drawMode) return; // géré ailleurs si mode édition
        const layer = e.layer;
        layer._isNewParcelle = true;
        drawLayer.addLayer(layer);

        const latlngs = layer.getLatLngs()[0];
        drawnNewSurface = computeAreaHa(latlngs);
        drawnNewGeoJson = JSON.stringify(layer.toGeoJSON().geometry);

        // Remplir et ouvrir le modal
        document.getElementById('new-parcelle-name').value = '';
        document.getElementById('new-parcelle-culture').value = '';
        document.getElementById('new-parcelle-ilot').value = '';
        document.getElementById('new-parcelle-commune').value = '';
        document.getElementById('new-parcelle-surface').textContent =
            drawnNewSurface ? drawnNewSurface.toFixed(4) + ' ha' : '— ha';
        map.removeControl(newDrawControl); // retirer l'outil dessin pendant le modal
        $('#modal-new-parcelle').modal('show');
    });

    $('#modal-new-parcelle').on('hidden.bs.modal', function() {
        if (drawMode && !drawnNewGeoJson) return; // annulé avant dessin
        exitDrawMode();
    });

    document.getElementById('btn-confirm-new-parcelle').addEventListener('click', function() {
        const name = document.getElementById('new-parcelle-name').value.trim();
        if (!name) { document.getElementById('new-parcelle-name').focus(); return; }

        fetch(CREATE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name:       name,
                surface:    drawnNewSurface,
                geoJson:    drawnNewGeoJson,
                culture_id: document.getElementById('new-parcelle-culture').value || null,
                ilot_id:    document.getElementById('new-parcelle-ilot').value    || null,
                commune:    document.getElementById('new-parcelle-commune').value  || null,
            }),
        })
        .then(r => r.json())
        .then(function(data) {
            if (data.ok) window.location.href = data.redirect || window.location.href;
            else alert('Erreur : ' + (data.error || 'inconnue'));
        })
        .catch(() => alert('Erreur réseau'));
    });

    // Clic sur le lien "✏ Contour" dans le popup
    map.on('popupopen', function(e) {
        e.popup.getElement().querySelectorAll('.popup-edit-contour').forEach(function(a) {
            a.addEventListener('click', function(ev) {
                ev.preventDefault();
                const id = this.dataset.id;
                startEditContour(id);
            });
        });
    });
});
</script>
{% endblock %}
