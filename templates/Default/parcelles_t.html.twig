{% extends 'base_agri.html.twig' %}

{% block body %}

<div class="card">
    <div class="card-header">
        <button type="button" class="btn btn-primary" onclick="window.location.href='{{ url("parcelle", {'parcelle_id': 0}) }}'">{{'Add' | trans }}</button>
        <a href="{{ path('parcelles_map') }}" class="btn btn-outline-secondary" title="Vue carte">
            ⬡ Carte
        </a>
        {% if parcelles | length == 0 %}
        <button type="button" id="btn-copy-previous" class="btn btn-outline-primary" title="Copier les parcelles de la campagne précédente">
            ⧉ Copier campagne précédente
        </button>
        {% endif %}

        Parcelles
    </div>

    <table class="table" id="table">
        {% for parcelle in parcelles %}
            <tr>
                <td>
                    <a href="{{ url("parcelle", {'parcelle_id': parcelle.id}) }}">{{parcelle.completeName}}
                    </a>
                </td>
                <td>
                    {{parcelle.name}}
                </td>
                <td>
                    {{parcelle.getIlotName()}}
                </td>
                <td>
                    {{parcelle.culture}}
                </td>
                <td>
                    {{ parcelle.surface | showHa }}
                </td>
                <td>
                    {% if parcelle.active %}✔{% else %}<span class="text-muted">Inactif</span>{% endif %}
                </td>
            </tr>
        {% endfor %}

    </table>
</div>

<div class="card">
    <div class="card-header">
        Cultures
        <span class="badge float-right">{{ (total) | showHa }}</span>
    </div>

    <table class="table" id="table">
        {% for key, culture in cultures %}
            <tr>
                <td>
                    {{key}}
                </td>
                <td>
                    {{ culture | showHa }}
                </td>
                <td>
                    {{ (culture/total) | showPercent }}
                </td>
            </tr>
        {% endfor %}

    </table>
</div>

{% if ilots | length > 0 %}
<div class="card">
    <div class="card-header">
        Ilots Restant
    </div>
    <div class="list-group">
        {% for ilot in ilots %}
        <div class="list-group-item flex-column align-items-start">
            <div class="d-flex w-100 justify-content-between">
                <h6 class="mb-1">
                    {{ilot["name"]}}

                </h6>
                <a href="{{ url("parcelle", {'parcelle_id': 0}) }}?surface={{ (ilot["surface_restante"])}}&ilot_id={{ (ilot["id"])}}">Ajouter</a>
            </div>
            <div class="row">
                <div class="col-md-4">
                    Surface Ilot: {{ ilot["surface_totale"] | showHa }}
                </div>
                <div class="col-md-4">
                    Surface restante: {{ (ilot["surface_restante"]) | showHa }}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<script>const COPY_PREVIOUS_URL = '{{ url('parcelles_copy_previous') }}';</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const btn = document.getElementById('btn-copy-previous');
    if (!btn) return;
    btn.addEventListener('click', function () {
        if (!confirm('Copier les parcelles de la campagne précédente dans la campagne actuelle ?')) return;
        btn.disabled = true;
        fetch(COPY_PREVIOUS_URL, { method: 'POST' })
            .then(r => r.json())
            .then(function (data) {
                if (data.ok) window.location.href = data.redirect || window.location.href;
                else { alert('Erreur : ' + (data.error || 'inconnue')); btn.disabled = false; }
            })
            .catch(() => { alert('Erreur réseau'); btn.disabled = false; });
    });
});
</script>

{% endblock %}
