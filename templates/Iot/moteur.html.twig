{% extends 'base_form.html.twig' %}

{% block body_form %}

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var typeSelect = document.getElementById('{{ form.type_temperature.vars.id }}');
        var baliseRow = document.getElementById('{{ form.balise.vars.id }}').closest('.form-group.row');
        var temperatureFixeRow = document.getElementById('{{ form.temperature_fixe.vars.id }}').closest('.form-group.row');

        function toggleTemperatureFields() {
            if (typeSelect.value === 'fixe') {
                baliseRow.style.display = 'none';
                temperatureFixeRow.style.display = '';
            } else {
                baliseRow.style.display = '';
                temperatureFixeRow.style.display = 'none';
            }
        }

        typeSelect.addEventListener('change', toggleTemperatureFields);
        toggleTemperatureFields();
    });
    </script>

    <div class="card">
    <div class="list-group">
        <div class="list-group-item flex-column align-items-start">
            <div class="d-flex w-100 justify-content-between">
                <h5 class="mb-1">
                    {%if moteur.is_ok %}
                        {%if moteur.my_last_value %}
                            <button type="button" class="btn btn-success"></button>
                        {% else %}
                            <button type="button" class="btn btn-secondary"></button>
                        {% endif %}
                    {% else %}
                        <button type="button" class="btn btn-danger"></button>
                    {% endif %}
                    {{moteur.label}}
                </h5>
            </div>

            <div class="row" style="min-height: 1.5rem;">
                <div class="col-md-4">
                    {{moteur.name}}
                </div>
                <div class="col-md-2">
                    {{moteur.last_update | showDatetime }}
                </div>
                <div class="col-md-2">
                    value : {{moteur.my_last_value }}
                </div>
                <div class="col-md-2">
                    temp  ext: {{moteur.last_temperature | showUnity("°C") }}
                </div>
            </div>
            <div class="row" style="min-height: 1.5rem;">
                <div class="col-md-4">
                    desired : {{moteur.desired }}
                </div>
                <div class="col-md-4">
                    debug : {{moteur.debug }}
                </div>
            </div>

        </div>
        <div class="list-group-item flex-column align-items-start">
            {%if moteur.type_temperature == 'fixe' %}
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">T° réf fixe</h5>
                </div>
                <div class="row" style="min-height: 1.5rem;">
                    <div class="col-md-4">
                        {{moteur.temperature_fixe | showUnity("°C") }}
                    </div>
                    <div class="col-md-2">
                        diff {{(moteur.temperature_fixe - moteur.last_temperature) | showUnity("°C") }}
                    </div>
                </div>
            {% elseif moteur.balise %}
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">
                        {%if moteur.balise.is_balise_ok %}
                            <button type="button" class="btn btn-success"></button>
                        {% else %}
                            <button type="button" class="btn btn-danger"></button>
                        {% endif %}
                        {{moteur.balise.label}}
                    </h5>
                </div>

                <div class="row" style="min-height: 1.5rem;">
                    <div class="col-md-4">
                        {{moteur.balise.name}}
                    </div>
                    <div class="col-md-2">
                        {{moteur.balise.last_update | showDatetime }}
                    </div>
                    <div class="col-md-2">
                        diff {{(moteur.balise.last_temp - moteur.last_temperature) | showUnity("°C") }}
                    </div>
                    <div class="col-md-2">
                        {{moteur.balise.last_temp | showUnity("°C") }}
                    </div>

                </div>
            {% endif %}

            </div>
        <div class="list-group-item flex-column align-items-start">
        <div class="row" style="min-height: 1.5rem;">
            <div class="col-md-2">
            <a href="?duree=all">all
            </a>
            </div>
            <div class="col-md-2">
            <a href="?duree=6m">6m
            </a>
            </div>
            <div class="col-md-2">
            <a href="?duree=1m">1m
            </a>
            </div>
            <div class="col-md-2">
            <a href="?duree=1w">1w
            </a>
            </div>
            <div class="col-md-2">
            <a href="?duree=1d">1d
            </a>
            </div>
        </div>
    </div>
    </div>
</div>

    
    <div class="card">
        <canvas id="myChart"></canvas>
    </div>

    <div class="card">
        <div class="card-header">
            Moteurs
        </div>
        <div class="list-group">
            {% for temperature in temperatures %}
            <div class="list-group-item flex-column align-items-start">
                <div class="row" style="min-height: 1.5rem;">
                    <div class="col-md-4">
                        {{temperature.datetime| showDatetime}}
                    </div>
                    <div class="col-md-2">
                        {{temperature.temp_ext | showUnity("°C") }}
                    </div>
                    <div class="col-md-2">
                        {{temperature.temp_sonde | showUnity("°C") }}
                    </div>
                    <div class="col-md-2">
                        {{temperature.on_off }}
                        {% if temperature.temp_sonde %}
                            ( diff {{(temperature.temp_sonde-temperature.temp_ext) | showUnity("°C")}})
                        {% endif %}
                    </div>
                    <div class="col-md-4">
                        desired  : {{temperature.desired_on_off }} {{temperature.debug }}
                    </div>
                </div>

            </div>
            {% endfor %}
        </div>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.13.0/moment.min.js"></script>
<script src='/lib/Chart.js/Chart.min.js'></script>
<script>
    var timeFormat = 'DD/MM/YYYY';

    var color = Chart.helpers.color;
    var config = {
        type: 'line',
        data: {
            datasets:[
                {% for chartjs in chartjss %}
                {
                    label: '{{chartjs['annee']}}',
                    fill: false,
                    backgroundColor: '{{chartjs['color']}}',
                    hidden: '{{chartjs['hidden']}}',
                    borderColor: '{{chartjs['color']}}',

                    data: [
                        {% for data in chartjs['data'] %}
                            {
                                x: "{{data['date']}}",
                                y: {{data['value']}},
                                text: "{{data['name']}}"
                            },
                        {% endfor %}
                    ],
                },
                {% endfor %}
            ]
        },
        options: {
            scales: {
                xAxes: [{
                    type: 'time',
                    distribution: 'linear'
                }]
            },
            elements: {
                    point:{
                        radius: 0
                    }
                }
        }
    };

    window.onload = function() {
        var ctx = document.getElementById('myChart').getContext('2d');
        window.myLine = new Chart(ctx, config);

    };
</script>

{% endblock %}
